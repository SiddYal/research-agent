# Copy to .env and fill in. One LLM key is required; OpenAI also provides embeddings.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic          # default: whichever key is set (OpenAI first)
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: Tavily search instead of DuckDuckGo
# TAVILY_API_KEY=

# Defaults to a local SQLite file. For Postgres + pgvector (e.g. Neon):
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Public-demo guardrails
# RATE_LIMIT=5/minute
# DAILY_COST_CAP_USD=2.00
# MAX_JOB_COST_USD=0.50

# LOG_JSON=true
